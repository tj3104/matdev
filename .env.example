# .env にコピーして使う。chmod 600 にすること
ANTHROPIC_API_KEY=
# 月の上限 [USD] (必須)。80% で知らせ、100% で止める。未設定だと依頼を受け付けない
MATDEV_MONTHLY_LIMIT_USD=
# MATDEV_AUTO_RUN_SECONDS=1800       # 見積もりがこれを超える計算は確認を取る
# MATDEV_MODEL=claude-opus-5-5          # 接続の確認などで安く試すなら claude-haiku-5-5 (入力の料金が 1/40)
# MATDEV_EFFORT=high
# 設定ファイル (matdev.json) で OpenAI 形式の LLM を使うときは、api_key_env に書いた名前で鍵を書く。例:
# LOCAL_LLM_KEY=
# 各アプリのパス・venv・データの場所・ポート・受ける接続の名前は paths.env に書く (paths.example.env を参照)
